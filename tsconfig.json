{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      { "name": "next" }, 
      { "name": "next-pwa"},
    ],
    "paths": {
      "res/*": ["./src/*"],
      "icons/*": ["./src/app/components/icons/*"],
      "parts/*": ["./src/app/components/*"],
      "types/*": ["./types/*"],
      "utils/*": ["./src/utils/*"],
      "earth/*": ["./src/app/earth/*"],
      "config/*": ["./src/app/config/*"],
      "styles/*": ["./src/styles/*"],

      // Alias Paths
      "@constants": ["./src/app/constants.ts"],
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    "global.d.ts",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
  ],
  "exclude": ["node_modules"]
}
